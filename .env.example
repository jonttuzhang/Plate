# Copy to .env and fill in. Both values are public (safe in the app bundle).
# Supabase dashboard → Project Settings → API. Use the *publishable* key, never the service role / secret key.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
